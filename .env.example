# ─────────────────────────────────────────────────────────────────────────────
# Tessera — environment template
# Copy to `.env` and fill in. Every variable here is validated at boot by
# packages/config; a missing or malformed required value fails startup loudly
# rather than defaulting to something insecure.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
APP_NAME=Tessera
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tessera:tessera@localhost:5432/tessera?schema=public
# Optional read replica. Falls back to DATABASE_URL when unset.
DATABASE_REPLICA_URL=
DATABASE_POOL_SIZE=20
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ── Redis ────────────────────────────────────────────────────────────────────
# Separate instances in production: evicting a queue entry loses a job.
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6379/1

# ── Object storage (S3-compatible) ───────────────────────────────────────────
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=tessera-local
STORAGE_ACCESS_KEY_ID=tessera
STORAGE_SECRET_ACCESS_KEY=tessera-secret
STORAGE_FORCE_PATH_STYLE=true
# Public base URL for attachment delivery (a separate origin from the app).
STORAGE_PUBLIC_URL=http://localhost:9000/tessera-local

# ── Search ───────────────────────────────────────────────────────────────────
SEARCH_DRIVER=opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_min_32_chars_______________________
JWT_SECRET=CHANGE_ME_min_32_chars_______________________
# 32-byte key, base64. Envelope-encrypts integration tokens, 2FA secrets, webhook secrets.
ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes___________________
ENCRYPTION_KEY_VERSION=1
SESSION_COOKIE_NAME=tessera_session
SESSION_TTL_HOURS=720
SESSION_IDLE_TIMEOUT_HOURS=168
ACCESS_TOKEN_TTL_MINUTES=15
BCRYPT_OR_ARGON=argon2id
TRUST_PROXY=false

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_FROM="Tessera <no-reply@tessera.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ── OAuth providers (optional in development) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Billing (optional in development) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tessera-api
SENTRY_DSN=
METRICS_ENABLED=true

# ── Limits / feature flags ───────────────────────────────────────────────────
MAX_UPLOAD_BYTES=104857600
RATE_LIMIT_ENABLED=true
SIGNUP_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true
ALLOW_UNSAFE_SEED=false

# Inlined into the client bundle at build time (must be set at BUILD time, not run time).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Airtable import (optional, used only by packages/importer) ────────────────
# A read-only Personal Access Token. Create one at
# https://airtable.com/create/tokens with exactly these scopes:
#
#     schema.bases:read      data.records:read
#
# Add every base you want to import under "Access". Grant nothing else: the
# importer only ever issues GET requests (see rest-source.ts), and a token
# without write scopes cannot alter the source account even if that code were
# wrong. This value is never sent to the Tessera API and never logged.
AIRTABLE_PAT=
