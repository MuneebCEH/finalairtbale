  revokedAt       DateTime? @map("revoked_at")
  createdById     String    @map("created_by_id") @db.Char(30)
  createdAt       DateTime  @default(now()) @map("created_at")
  lastAccessedAt  DateTime? @map("last_accessed_at")
  accessCount     Int       @default(0) @map("access_count")

  view View @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@index([organizationId, viewId])
  @@map("view_shares")
}

// ---------------------------------------------------------------------------
// Collaboration
// ---------------------------------------------------------------------------

model Comment {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  baseId         String    @map("base_id") @db.Char(30)
  /// Polymorphic subject: record | view | interface | automation | field
  subjectType    String    @map("subject_type") @db.VarChar(24)
  subjectId      String    @map("subject_id") @db.Char(30)
  /// Set for field-level comments on a record.
  fieldId        String?   @map("field_id") @db.Char(30)
  parentId       String?   @map("parent_id") @db.Char(30)
  /// Sanitised rich-text document. Sanitisation happens on write and again on render.
  body           Json
  plainText      String    @map("plain_text") @db.Text
  authorId       String    @map("author_id") @db.Char(30)
  resolvedAt     DateTime? @map("resolved_at")
  resolvedById   String?   @map("resolved_by_id") @db.Char(30)
  editedAt       DateTime? @map("edited_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  mentions  CommentMention[]
  reactions CommentReaction[]

  @@index([organizationId, subjectType, subjectId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model CommentMention {
  commentId      String    @map("comment_id") @db.Char(30)
  userId         String    @map("user_id") @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  notifiedAt     DateTime? @map("notified_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

model CommentReaction {
  commentId      String   @map("comment_id") @db.Char(30)
  userId         String   @map("user_id") @db.Char(30)
  /// Denormalised like every other tenant-owned row, so the row-level security policy has a
  /// column to key on. Without it this table would be the one unprotected surface in the
  /// collaboration domain.
  organizationId String   @map("organization_id") @db.Char(30)
  emoji          String   @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, emoji])
  @@map("comment_reactions")
}

model Notification {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  userId         String    @map("user_id") @db.Char(30)
  type           String    @db.VarChar(48)
  title          String    @db.VarChar(255)
  body           String?   @db.Text
  /// Deep link to the affected content.
  targetUrl      String?   @map("target_url") @db.Text
  metadata       Json      @default("{}")
  /// Notifications of the same kind on the same subject collapse into one row with a count.
  groupKey       String?   @map("group_key") @db.VarChar(120)
  groupCount     Int       @default(1) @map("group_count")
  readAt         DateTime? @map("read_at")
  emailedAt      DateTime? @map("emailed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([organizationId, userId, groupKey])
  @@map("notifications")
}

