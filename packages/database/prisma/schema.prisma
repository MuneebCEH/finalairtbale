  @@id([organizationId, periodStart, unit])
  @@map("usage_summaries")
}

// ---------------------------------------------------------------------------
// Governance
// ---------------------------------------------------------------------------

/// Append-only. The application role holds INSERT and SELECT but not UPDATE or DELETE;
/// retention is enforced by dropping partitions, and a legal hold blocks the drop.
model AuditLog {
  id             String   @id @db.Char(30)
  organizationId String   @map("organization_id") @db.Char(30)
  actorType      String   @map("actor_type") @db.VarChar(16)
  actorId        String?  @map("actor_id") @db.Char(30)
  /// Set when a platform administrator acted through the audited impersonation flow.
  impersonatorId String?  @map("impersonator_id") @db.Char(30)
  action         String   @db.VarChar(64)
  resourceType   String   @map("resource_type") @db.VarChar(32)
  resourceId     String?  @map("resource_id") @db.Char(30)
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent") @db.Text
  correlationId  String?  @map("correlation_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, actorId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
}

/// Transactional outbox. Rows are written in the same transaction as the state change and
/// relayed to consumers afterwards, so an event can be neither phantom nor lost.
model DomainEventOutbox {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  type           String    @db.VarChar(48)
  version        Int       @default(1)
  tenant         Json
  actor          Json
  payload        Json
  correlationId  String?   @map("correlation_id") @db.VarChar(64)
  causationId    String?   @map("causation_id") @db.Char(30)
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  publishedAt    DateTime? @map("published_at")
  attempts       Int       @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([publishedAt, occurredAt])
  @@index([organizationId, type, occurredAt])
  @@map("domain_events")
}

/// Trash. A soft-deleted resource of any type gets a row here so a single query powers the
/// trash UI and the retention sweeper, rather than a UNION over a dozen tables.
model DeletedItem {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  resourceType   String    @map("resource_type") @db.VarChar(32)
  resourceId     String    @map("resource_id") @db.Char(30)
  parentType     String?   @map("parent_type") @db.VarChar(32)
  parentId       String?   @map("parent_id") @db.Char(30)
  name           String?   @db.VarChar(255)
  deletedById    String?   @map("deleted_by_id") @db.Char(30)
  deletedAt      DateTime  @default(now()) @map("deleted_at")
  /// Hard deletion happens after this instant unless a legal hold intervenes.
  purgeAfter     DateTime  @map("purge_after")
  restoredAt     DateTime? @map("restored_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId])
  @@index([organizationId, deletedAt])
  @@index([purgeAfter])
  @@map("deleted_items")
}

model FeatureFlag {
  key            String   @id @db.VarChar(64)
  description    String?  @db.Text
  enabled        Boolean  @default(false)
  /// Percentage rollout and explicit allow/deny lists by organization.
  rolloutPercent Int      @default(0) @map("rollout_percent")
  enabledOrgIds  String[] @default([]) @map("enabled_org_ids")
  disabledOrgIds String[] @default([]) @map("disabled_org_ids")
  updatedById    String?  @map("updated_by_id") @db.Char(30)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model Template {
  id             String   @id @db.Char(30)
  /// Null for public templates published by the platform.
  organizationId String?  @map("organization_id") @db.Char(30)
  name           String   @db.VarChar(120)
  slug           String   @unique @db.VarChar(64)
  category       String   @db.VarChar(48)
  description    String?  @db.Text
  coverImageUrl  String?  @map("cover_image_url") @db.Text
  /// Full base definition: tables, fields, views, sample records, forms, automations.
  definition     Json
  visibility     String   @default("private") @db.VarChar(16)
  useCount       Int      @default(0) @map("use_count")
  ratingSum      Int      @default(0) @map("rating_sum")
  ratingCount    Int      @default(0) @map("rating_count")
  createdById    String?  @map("created_by_id") @db.Char(30)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([category, visibility])
  @@map("templates")
}
