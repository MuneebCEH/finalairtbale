model FormSubmission {
  id             String   @id @db.Char(30)
  organizationId String   @map("organization_id") @db.Char(30)
  formId         String   @map("form_id") @db.Char(30)
  recordId       String?  @map("record_id") @db.Char(30)
  submittedById  String?  @map("submitted_by_id") @db.Char(30)
  ipHash         String?  @map("ip_hash") @db.Char(64)
