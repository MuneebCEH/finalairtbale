  slug            String    @unique @db.VarChar(64)
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  /// Pages, fields, conditional rules, branding, confirmation behaviour.
  config          Json      @default("{}")
  isPublished     Boolean   @default(false) @map("is_published")
  requiresAuth    Boolean   @default(false) @map("requires_auth")
  passwordHash    String?   @map("password_hash") @db.Text
  captchaEnabled  Boolean   @default(false) @map("captcha_enabled")
  submissionLimit Int?      @map("submission_limit")
