  @@map("automation_versions")
}

model AutomationRun {
  id                  String    @id @db.Char(30)
  organizationId      String    @map("organization_id") @db.Char(30)
  automationVersionId String    @map("automation_version_id") @db.Char(30)
  /// The idempotency key: a redelivered event conflicts here and is dropped.
  triggerEventId      String    @map("trigger_event_id") @db.Char(30)
  status              String    @db.VarChar(16) // queued | running | succeeded | failed | cancelled
  /// Automation ids already in this causal chain, for loop detection.
  causationChain      String[]  @default([]) @map("causation_chain")
  context             Json      @default("{}")
  errorCode           String?   @map("error_code") @db.VarChar(48)
  startedAt           DateTime? @map("started_at")
  finishedAt          DateTime? @map("finished_at")
  durationMs          Int?      @map("duration_ms")
  createdAt           DateTime  @default(now()) @map("created_at")

  version AutomationVersion   @relation(fields: [automationVersionId], references: [id], onDelete: Cascade)
  steps   AutomationRunStep[]

  @@unique([automationVersionId, triggerEventId])
  @@index([organizationId, status, createdAt])
  @@map("automation_runs")
}

model AutomationRunStep {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  runId          String    @map("run_id") @db.Char(30)
  stepId         String    @map("step_id") @db.VarChar(64)
  attempt        Int       @default(1)
  status         String    @db.VarChar(16)
  input          Json?
  output         Json?
  error          Json?
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, stepId])
  @@map("automation_run_steps")
}

