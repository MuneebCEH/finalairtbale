model Automation {
  id              String    @id @db.Char(30)
  organizationId  String    @map("organization_id") @db.Char(30)
  baseId          String    @map("base_id") @db.Char(30)
  name            String    @db.VarChar(120)
  description     String?   @db.Text
  enabled         Boolean   @default(false)
  activeVersionId String?   @map("active_version_id") @db.Char(30)
  createdById     String    @map("created_by_id") @db.Char(30)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  versions AutomationVersion[]

  @@index([organizationId, baseId])
  @@map("automations")
}

model AutomationVersion {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  automationId   String    @map("automation_id") @db.Char(30)
  version        Int
  trigger        Json
  graph          Json
  status         String    @default("draft") @db.VarChar(16)
  notes          String?   @db.Text
  publishedAt    DateTime? @map("published_at")
  publishedById  String?   @map("published_by_id") @db.Char(30)
  createdAt      DateTime  @default(now()) @map("created_at")

