model ApiToken {
  id             String    @id @db.Char(30)
  organizationId String?   @map("organization_id") @db.Char(30)
  userId         String    @map("user_id") @db.Char(30)
  name           String    @db.VarChar(120)
  /// SHA-256 of the token. The plaintext is displayed exactly once, at creation.
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  /// Short non-secret prefix so a token can be identified in a list and in logs.
  tokenPrefix    String    @map("token_prefix") @db.VarChar(16)
  scopes         String[]  @default([])
  /// Optional restriction of the token to specific bases.
  baseIds        String[]  @default([]) @map("base_ids")
  ipAllowlist    String[]  @default([]) @map("ip_allowlist")
  expiresAt      DateTime? @map("expires_at")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("api_tokens")
}

model Webhook {
  id                   String    @id @db.Char(30)
  organizationId       String    @map("organization_id") @db.Char(30)
  baseId               String    @map("base_id") @db.Char(30)
  url                  String    @db.Text
  eventTypes           String[]  @default([]) @map("event_types")
  /// Envelope-encrypted signing secret, with a previous secret retained during rotation.
  secretCipher         Bytes     @map("secret_cipher")
  previousSecretCipher Bytes?    @map("previous_secret_cipher")
  secretRotatedAt      DateTime? @map("secret_rotated_at")
  keyVersion           Int       @default(1) @map("key_version")
  enabled              Boolean   @default(true)
  /// Consecutive failures; at the threshold the endpoint is marked unhealthy and paused.
  failureStreak        Int       @default(0) @map("failure_streak")
  health               String    @default("healthy") @db.VarChar(16)
  createdById          String    @map("created_by_id") @db.Char(30)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([organizationId, baseId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  webhookId      String    @map("webhook_id") @db.Char(30)
  eventId        String    @map("event_id") @db.Char(30)
  eventType      String    @map("event_type") @db.VarChar(48)
  attempt        Int       @default(1)
  status         String    @db.VarChar(16)
  responseCode   Int?      @map("response_code")
  /// Capped at 2 KB; a webhook receiver's error page must not become our storage problem.
  responseBody   String?   @map("response_body") @db.VarChar(2048)
  latencyMs      Int?      @map("latency_ms")
  errorMessage   String?   @map("error_message") @db.Text
  scheduledFor   DateTime? @map("scheduled_for")
  createdAt      DateTime  @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([organizationId, webhookId, createdAt])
  @@index([eventId])
  @@map("webhook_deliveries")
}

model IntegrationConnection {
  id                   String    @id @db.Char(30)
  organizationId       String    @map("organization_id") @db.Char(30)
  provider             String    @db.VarChar(32)
  /// User-owned or organization-owned connection.
  ownerScope           String    @map("owner_scope") @db.VarChar(16)
  ownerId              String    @map("owner_id") @db.Char(30)
  externalAccountId    String?   @map("external_account_id") @db.VarChar(255)
  externalAccountLabel String?   @map("external_account_label") @db.VarChar(255)
  scopes               String[]  @default([])
  accessTokenCipher    Bytes     @map("access_token_cipher")
  refreshTokenCipher   Bytes?    @map("refresh_token_cipher")
  keyVersion           Int       @default(1) @map("key_version")
  expiresAt            DateTime? @map("expires_at")
  status               String    @default("connected") @db.VarChar(16)
  lastError            String?   @map("last_error") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  revokedAt            DateTime? @map("revoked_at")

  @@index([organizationId, provider])
  @@map("integration_connections")
}

