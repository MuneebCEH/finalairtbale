}

model InterfaceComponent {
  id             String   @id @db.Char(30)
  organizationId String   @map("organization_id") @db.Char(30)
  pageId         String   @map("page_id") @db.Char(30)
  type           String   @db.VarChar(32)
  position       Json     @default("{}")
  config         Json     @default("{}")
  dataBinding    Json?    @map("data_binding")
  visibilityRule Json?    @map("visibility_rule")
  createdAt      DateTime @default(now()) @map("created_at")
