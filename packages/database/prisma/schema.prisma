// ---------------------------------------------------------------------------
// Tessera -- database schema
//
// Design notes that are not expressible in Prisma DSL and live in raw SQL migrations instead:
//   * `records` and `record_links` are HASH-partitioned on organization_id (32 partitions).
//   * Append-only tables are RANGE-partitioned on time so retention is a partition drop.
//   * Row-level security is enabled and FORCEd on every tenant table, keyed on
//     current_setting('app.current_org'). See migrations/*_rls.sql.
//   * The promoted slot columns on `records` (s0..s3, n0..n3, d0..d2, b0..b1) carry per-slot
//     partial btree indexes created CONCURRENTLY by the field-promotion job.
//
// Every tenant-owned table denormalises `organizationId`. It is redundant with the parent chain
// on purpose: it makes RLS a single predicate, gives every index a tenant prefix, and lets a
// composite foreign key make cross-tenant references structurally impossible.
//
// See docs/02-database-design.md.
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]

  // The query engine is a native binary, and the default — `native` alone — builds only for the
  // machine that ran `prisma generate`. Generating on Windows or macOS and deploying to Linux
  // then fails at the first query with an error that names a missing engine file rather than the
  // platform mismatch that caused it.
  //
  // The Linux targets differ by OpenSSL version, not distribution: `1.0.x` covers CentOS 7 and
  // its derivatives, `3.0.x` covers AlmaLinux/Rocky 9 and Debian 12, which is what the Docker
  // images are built on.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id              String    @id @db.Char(30)
  email           String    @unique @db.VarChar(254)
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String?   @map("password_hash") @db.Text
  name            String    @db.VarChar(120)
  avatarUrl       String?   @map("avatar_url") @db.Text
  timezone        String    @default("UTC") @db.VarChar(64)
  locale          String    @default("en") @db.VarChar(10)
  theme           String    @default("system") @db.VarChar(10)

  // Second factor
  twoFactorEnabled     Boolean @default(false) @map("two_factor_enabled")
  totpSecretCipher     Bytes?  @map("totp_secret_cipher")
  totpSecretKeyVersion Int?    @map("totp_secret_key_version")

  // Abuse controls
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  lastLoginIp      String?   @map("last_login_ip") @db.Inet

  isPlatformAdmin     Boolean   @default(false) @map("is_platform_admin")
  status              String    @default("active") @db.VarChar(20) // active | suspended | pending_deletion
  deletionRequestedAt DateTime? @map("deletion_requested_at")

  notificationPreferences Json @default("{}") @map("notification_preferences")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions                UserSession[]
  identities              Identity[]
  credentials             UserCredential[]
  recoveryCodes           RecoveryCode[]
  organizationMemberships OrganizationMember[]
  workspaceMemberships    WorkspaceMember[]
  groupMemberships        OrganizationGroupMember[]
  apiTokens               ApiToken[]
  notifications           Notification[]
  invitationsSent         Invitation[]              @relation("InvitationInviter")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// Federated identities (Google, Microsoft, GitHub). A user may hold several.
model Identity {
  id                 String    @id @db.Char(30)
  userId             String    @map("user_id") @db.Char(30)
  provider           String    @db.VarChar(32)
  providerUserId     String    @map("provider_user_id") @db.VarChar(255)
  email              String?   @db.VarChar(254)
  /// Refresh tokens are envelope-encrypted; the plaintext never touches a column.
  refreshTokenCipher Bytes?    @map("refresh_token_cipher")
  keyVersion         Int?      @map("key_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastUsedAt         DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identities")
}

/// Passkeys / WebAuthn credentials. Populated from Phase 8; the model ships now so the
/// authentication flow has a place to grow into without a schema migration under pressure.
model UserCredential {
  id           String    @id @db.Char(30)
  userId       String    @map("user_id") @db.Char(30)
  credentialId String    @unique @map("credential_id") @db.Text
  publicKey    Bytes     @map("public_key")
  signCount    BigInt    @default(0) @map("sign_count")
  transports   String[]  @default([])
  label        String?   @db.VarChar(120)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_credentials")
}

model RecoveryCode {
  id        String    @id @db.Char(30)
  userId    String    @map("user_id") @db.Char(30)
  /// Stored as a hash. A recovery code is a password.
  codeHash  String    @map("code_hash") @db.Text
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model UserSession {
  id                String    @id @db.Char(30)
  userId            String    @map("user_id") @db.Char(30)
  /// SHA-256 of the refresh token. The plaintext is only ever in a cookie.
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  /// Rotation lineage: reuse of a rotated token means theft, and revokes the whole family.
  familyId          String    @map("family_id") @db.Char(30)
  previousTokenHash String?   @map("previous_token_hash") @db.Char(64)
  ipAddress         String?   @map("ip_address") @db.Inet
  userAgent         String?   @map("user_agent") @db.Text
  deviceLabel       String?   @map("device_label") @db.VarChar(120)
  location          String?   @db.VarChar(120)
  mfaSatisfied      Boolean   @default(false) @map("mfa_satisfied")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId])
  @@map("user_sessions")
}

/// Single-use tokens: email verification, password reset, magic link, MFA challenge.
model AuthToken {
  id         String    @id @db.Char(30)
  userId     String?   @map("user_id") @db.Char(30)
  email      String?   @db.VarChar(254)
  purpose    String    @db.VarChar(32)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  metadata   Json      @default("{}")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdIp  String?   @map("created_ip") @db.Inet

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id          String    @id @db.Char(30)
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(48)
  logoUrl     String?   @map("logo_url") @db.Text
  brandColor  String?   @map("brand_color") @db.Char(7)
  plan        String    @default("free") @db.VarChar(20)
  status      String    @default("active") @db.VarChar(20) // active | suspended | pending_deletion
  /// Governance switches read by the policy engine. See OrganizationSettings in validation.
  settings    Json      @default("{}")
  /// Data residency seam. Single-region today; the column exists so routing is a config change.
  region      String    @default("default") @db.VarChar(32)
  /// Sharding seam -- see docs/09-scaling-strategy.md 2 step 6.
  shardId     Int       @default(0) @map("shard_id")
  legalHold   Boolean   @default(false) @map("legal_hold")
  trialEndsAt DateTime? @map("trial_ends_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  members      OrganizationMember[]
  groups       OrganizationGroup[]
  workspaces   Workspace[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  apiTokens    ApiToken[]
  subscription Subscription?
  usageEvents  UsageEvent[]
  domainEvents DomainEventOutbox[]
  deletedItems DeletedItem[]

  @@index([status])
  @@index([shardId])
  @@map("organizations")
}

model OrganizationMember {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  userId         String    @map("user_id") @db.Char(30)
  role           String    @db.VarChar(20)
  status         String    @default("active") @db.VarChar(20) // active | suspended
  invitedById    String?   @map("invited_by_id") @db.Char(30)
  joinedAt       DateTime  @default(now()) @map("joined_at")
  lastActiveAt   DateTime? @map("last_active_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

model OrganizationGroup {
  id             String   @id @db.Char(30)
  organizationId String   @map("organization_id") @db.Char(30)
  name           String   @db.VarChar(120)
  description    String?  @db.Text
  /// System groups (e.g. "Everyone") cannot be deleted or renamed.
  isSystem       Boolean  @default(false) @map("is_system")
  createdById    String?  @map("created_by_id") @db.Char(30)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members              OrganizationGroupMember[]
  workspaceMemberships WorkspaceMember[]

  @@unique([organizationId, name])
  @@map("organization_groups")
}

model OrganizationGroupMember {
  groupId String   @map("group_id") @db.Char(30)
  userId  String   @map("user_id") @db.Char(30)
  addedAt DateTime @default(now()) @map("added_at")

  group OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("organization_group_members")
}

model Invitation {
  id               String    @id @db.Char(30)
  organizationId   String    @map("organization_id") @db.Char(30)
  email            String    @db.VarChar(254)
  role             String    @db.VarChar(20)
  /// Immediate workspace grants applied on acceptance: [{ workspaceId, role }]
  workspaceGrants  Json      @default("[]") @map("workspace_grants")
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  message          String?   @db.Text
  invitedById      String    @map("invited_by_id") @db.Char(30)
  expiresAt        DateTime  @map("expires_at")
  acceptedAt       DateTime? @map("accepted_at")
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Char(30)
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("invitations")
}

model Workspace {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  name           String    @db.VarChar(120)
  description    String?   @db.Text
  icon           String?   @db.VarChar(64)
  color          String?   @db.Char(7)
  position       Int       @default(0)
  archivedAt     DateTime? @map("archived_at")
  createdById    String    @map("created_by_id") @db.Char(30)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  bases        Base[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt, deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id             String   @id @db.Char(30)
  organizationId String   @map("organization_id") @db.Char(30)
  workspaceId    String   @map("workspace_id") @db.Char(30)
  /// Exactly one of userId / groupId is set (enforced by a CHECK constraint in SQL).
  userId         String?  @map("user_id") @db.Char(30)
  groupId        String?  @map("group_id") @db.Char(30)
  role           String   @db.VarChar(20)
  addedById      String?  @map("added_by_id") @db.Char(30)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     OrganizationGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@unique([workspaceId, groupId])
  @@index([userId])
  @@index([organizationId, workspaceId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Bases, tables, fields, records  (Phase 2+ -- modelled now so migrations are additive)
// ---------------------------------------------------------------------------

model Base {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  workspaceId    String    @map("workspace_id") @db.Char(30)
  name           String    @db.VarChar(120)
  description    String?   @db.Text
  icon           String?   @db.VarChar(64)
  color          String?   @db.Char(7)
  position       Int       @default(0)
  /// Bumped on any schema change; caches and clients key off it.
  schemaVersion  Int       @default(1) @map("schema_version")
  templateId     String?   @map("template_id") @db.Char(30)
  archivedAt     DateTime? @map("archived_at")
  createdById    String    @map("created_by_id") @db.Char(30)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   BaseMember[]
  tables    Table[]

  @@index([organizationId, workspaceId, deletedAt])
  @@map("bases")
}

model BaseMember {
  id             String   @id @db.Char(30)
  organizationId String   @map("organization_id") @db.Char(30)
  baseId         String   @map("base_id") @db.Char(30)
  userId         String?  @map("user_id") @db.Char(30)
  groupId        String?  @map("group_id") @db.Char(30)
  role           String   @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  base Base @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@unique([baseId, userId])
  @@unique([baseId, groupId])
  @@index([userId])
  @@map("base_members")
}

model Table {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  baseId         String    @map("base_id") @db.Char(30)
  name           String    @db.VarChar(120)
  description    String?   @db.Text
  icon           String?   @db.VarChar(64)
  color          String?   @db.Char(7)
  position       Int       @default(0)
  /// The field shown as the record's label everywhere it is referenced.
  primaryFieldId String?   @map("primary_field_id") @db.Char(30)
  /// Bumped on every write; view-query cache keys embed it, so invalidation is free.
  dataVersion    BigInt    @default(1) @map("data_version")
  recordCount    Int       @default(0) @map("record_count")
  autoNumberSeq  BigInt    @default(0) @map("auto_number_seq")
  hiddenAt       DateTime? @map("hidden_at")
  archivedAt     DateTime? @map("archived_at")
  createdById    String    @map("created_by_id") @db.Char(30)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  base   Base    @relation(fields: [baseId], references: [id], onDelete: Cascade)
  fields Field[]
  views  View[]

  @@unique([baseId, name])
  @@index([organizationId, baseId, deletedAt])
  @@map("tables")
}

model Field {
  id               String    @id @db.Char(30)
  organizationId   String    @map("organization_id") @db.Char(30)
  tableId          String    @map("table_id") @db.Char(30)
  name             String    @db.VarChar(120)
  type             String    @db.VarChar(32)
  description      String?   @db.Text
  position         Int       @default(0)
  isPrimary        Boolean   @default(false) @map("is_primary")
  isRequired       Boolean   @default(false) @map("is_required")
  isUnique         Boolean   @default(false) @map("is_unique")
  /// Type-specific configuration: select options, number precision, formula source, link target
  options          Json      @default("{}")
  defaultValue     Json?     @map("default_value")
  /// Physical column this field has been promoted into for indexed filter/sort. Null = JSONB only.
  promotedSlot     String?   @map("promoted_slot") @db.VarChar(4)
  promotionState   String?   @map("promotion_state") @db.VarChar(16) // pending | backfilling | ready
  /// For linked-record fields: the field on the other table that mirrors this relationship.
  symmetricFieldId String?   @map("symmetric_field_id") @db.Char(30)
  /// Cached compile output for formula fields (AST hash, return type, cost).
  computeMeta      Json?     @map("compute_meta")
  createdById      String    @map("created_by_id") @db.Char(30)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  table        Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  dependencies FieldDependency[] @relation("DependentField")
  dependents   FieldDependency[] @relation("SourceField")

  @@unique([tableId, name])
  @@index([organizationId, tableId, deletedAt])
  @@map("fields")
}

model FieldDependency {
  organizationId   String @map("organization_id") @db.Char(30)
  dependentFieldId String @map("dependent_field_id") @db.Char(30)
  sourceFieldId    String @map("source_field_id") @db.Char(30)
  /// The link field a lookup/rollup traverses. Empty string (not NULL) for a same-table
  /// dependency, because a nullable column cannot participate in a primary key.
  viaLinkFieldId   String @default("") @map("via_link_field_id") @db.VarChar(30)

  dependent Field @relation("DependentField", fields: [dependentFieldId], references: [id], onDelete: Cascade)
  source    Field @relation("SourceField", fields: [sourceFieldId], references: [id], onDelete: Cascade)

  @@id([dependentFieldId, sourceFieldId, viaLinkFieldId])
  @@index([organizationId, sourceFieldId])
  @@map("field_dependencies")
}

/// See docs/02-database-design.md 1.5 for why this shape was chosen over EAV, pure JSONB,
/// dynamic physical tables, and a columnar store.
model Record {
  id             String @id @db.Char(30)
  organizationId String @map("organization_id") @db.Char(30)
  tableId        String @map("table_id") @db.Char(30)
  data           Json   @default("{}")

  // Promoted typed slots. Assigned by the field-promotion job, indexed per slot.
  s0 String?   @db.Text
  s1 String?   @db.Text
  s2 String?   @db.Text
  s3 String?   @db.Text
  n0 Decimal?  @db.Decimal(38, 10)
  n1 Decimal?  @db.Decimal(38, 10)
  n2 Decimal?  @db.Decimal(38, 10)
  n3 Decimal?  @db.Decimal(38, 10)
  d0 DateTime?
  d1 DateTime?
  d2 DateTime?
  b0 Boolean?
  b1 Boolean?

  version     Int       @default(1)
  autoNumber  BigInt    @map("auto_number")
  // `created_by` / `updated_by`, not the auto-derived `*_by_id`. These two columns are named
  // explicitly in the hand-written SQL of the query builder and the record repository, and in
  // docs/02-database-design.md. Where raw SQL and the ORM must agree on a column name, the name
  // is pinned here rather than left to a naming convention that a later refactor could shift.
  createdById String?   @map("created_by") @db.Char(30)
  updatedById String?   @map("updated_by") @db.Char(30)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([organizationId, tableId, id])
  @@index([organizationId, tableId, updatedAt])
  @@map("records")
}

model RecordLink {
  id             String   @id @db.Char(30)
  organizationId String   @map("organization_id") @db.Char(30)
  fieldId        String   @map("field_id") @db.Char(30)
  sourceRecordId String   @map("source_record_id") @db.Char(30)
  targetRecordId String   @map("target_record_id") @db.Char(30)
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([fieldId, sourceRecordId, targetRecordId])
  @@index([organizationId, fieldId, sourceRecordId])
  @@index([organizationId, fieldId, targetRecordId])
  @@map("record_links")
}

model RecordRevision {
  id             String   @id @db.Char(30)
  organizationId String   @map("organization_id") @db.Char(30)
  tableId        String   @map("table_id") @db.Char(30)
  recordId       String   @map("record_id") @db.Char(30)
  version        Int
  /// { fieldId: { from, to } } -- a diff, never a full snapshot.
  changes        Json
  actorType      String   @map("actor_type") @db.VarChar(16)
  actorId        String?  @map("actor_id") @db.Char(30)
  source         String   @db.VarChar(24) // ui | api | automation | import | formula
  correlationId  String?  @map("correlation_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, recordId, version])
  @@index([organizationId, tableId, createdAt])
  @@map("record_revisions")
}

// ---------------------------------------------------------------------------
// Views
// ---------------------------------------------------------------------------

model View {
  id             String    @id @db.Char(30)
  organizationId String    @map("organization_id") @db.Char(30)
  tableId        String    @map("table_id") @db.Char(30)
  name           String    @db.VarChar(120)
  type           String    @db.VarChar(24)
  description    String?   @db.Text
  icon           String?   @db.VarChar(64)
  position       Int       @default(0)
  /// Personal views are visible only to their owner and are not part of the shared schema.
  isPersonal     Boolean   @default(false) @map("is_personal")
  ownerId        String?   @map("owner_id") @db.Char(30)
  lockedAt       DateTime? @map("locked_at")
  lockedById     String?   @map("locked_by_id") @db.Char(30)
  /// Filters, sorts, groups, field visibility/order, row height, colour rules.
  config         Json      @default("{}")
  /// View-type specific settings (kanban stack field, calendar date field, chart spec).
  typeConfig     Json      @default("{}") @map("type_config")
  version        Int       @default(1)
  createdById    String    @map("created_by_id") @db.Char(30)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  table  Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  shares ViewShare[]

  @@index([organizationId, tableId, deletedAt])
  @@index([ownerId])
  @@map("views")
}

model ViewShare {
  id              String    @id @db.Char(30)
  organizationId  String    @map("organization_id") @db.Char(30)
  viewId          String    @map("view_id") @db.Char(30)
  slug            String    @unique @db.VarChar(64)
  capability      String    @db.VarChar(32)
  passwordHash    String?   @map("password_hash") @db.Text
