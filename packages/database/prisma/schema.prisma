model UsageEvent {
  id             String   @id @db.Char(30)
  organizationId String   @map("organization_id") @db.Char(30)
  unit           String   @db.VarChar(32)
  quantity       BigInt
  /// Resource the usage is attributed to, for per-base and per-user breakdowns.
  subjectType    String?  @map("subject_type") @db.VarChar(24)
  subjectId      String?  @map("subject_id") @db.Char(30)
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, unit, occurredAt])
