  scanDetail     String?   @map("scan_detail") @db.Text
  uploadedById   String?   @map("uploaded_by_id") @db.Char(30)
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  @@index([organizationId, createdAt])
  @@index([scanStatus])
  @@map("attachments")
}

