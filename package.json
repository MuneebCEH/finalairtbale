{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "description": "Tessera — collaborative relational workspace platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "verify": "turbo run build typecheck lint test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "npm run test:e2e --workspace=@tessera/web",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:generate": "npm run db:generate --workspace=@tessera/database",
    "db:migrate": "npm run db:migrate --workspace=@tessera/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@tessera/database",
    "db:seed": "npm run db:seed --workspace=@tessera/database",
    "db:secure": "npm run db:secure --workspace=@tessera/database",
    "db:studio": "npm run db:studio --workspace=@tessera/database",
    "db:reset": "npm run db:reset --workspace=@tessera/database",
    "smoke": "node scripts/smoke.mjs",
    "smoke:data": "node scripts/smoke-data.mjs",
    "smoke:realtime": "node scripts/smoke-realtime.mjs",
    "smoke:all": "npm run smoke && npm run smoke:data && npm run smoke:realtime",
    "//db:local": "Portable PostgreSQL for machines without Docker. Docker Compose remains the documented path.",
    "db:local": "node scripts/local-postgres.mjs start",
    "db:local:reset": "node scripts/local-postgres.mjs reset",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/compose/docker-compose.yml logs -f",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
