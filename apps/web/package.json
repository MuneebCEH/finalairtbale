{
  "name": "@tessera/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "//build": "NEXT_BUILD_DIR keeps the production build out of the dev server's .next, so the two can run at once.",
    "build": "cross-env NEXT_BUILD_DIR=.next-build next build",
    "dev": "next dev -p 3000",
    "start": "next start -p 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "clean": "rimraf .next dist .turbo",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tessera/types": "*",
    "@tessera/validation": "*",
    "clsx": "^2.1.1",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint-config-next": "^14.2.15",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
