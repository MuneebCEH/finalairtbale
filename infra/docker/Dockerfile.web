# syntax=docker/dockerfile:1.7
# Web image, built on Next.js standalone output.
#
# `output: 'standalone'` traces the exact files the server needs and emits a self-contained
# bundle, so the runtime layer holds neither node_modules in full nor the build toolchain.

FROM node:20.18-bookworm-slim AS deps
WORKDIR /app
ENV npm_config_update_notifier=false

COPY package.json package-lock.json ./
COPY packages/types/package.json      packages/types/
COPY packages/config/package.json     packages/config/
COPY packages/validation/package.json packages/validation/
COPY apps/web/package.json            apps/web/

RUN --mount=type=cache,target=/root/.npm \
    npm ci --workspaces --include-workspace-root --omit=optional

FROM deps AS build
WORKDIR /app
COPY tsconfig.base.json turbo.json ./
COPY packages/ packages/
COPY apps/web/ apps/web/

# NEXT_PUBLIC_* values are inlined at build time, so the API URL must be supplied here rather
# than at run time. Different environments therefore build different images — which is the
# honest trade-off of client-side environment variables, not something to paper over.
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1

RUN npx turbo run build --filter=@tessera/web...

FROM node:20.18-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN groupadd --system --gid 1001 tessera \
 && useradd  --system --uid 1001 --gid tessera tessera

COPY --from=build --chown=tessera:tessera /app/apps/web/.next/standalone ./
COPY --from=build --chown=tessera:tessera /app/apps/web/.next/static     ./apps/web/.next/static
COPY --from=build --chown=tessera:tessera /app/apps/web/public           ./apps/web/public

USER tessera
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
